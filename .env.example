# Variables de entorno públicas de Firebase (prefijo EXPO_PUBLIC_).
#
# Cómo rellenar:
#   1. Ve a https://console.firebase.google.com/ y abre el proyecto Itera.
#   2. En "Configuración del proyecto" (icono de engranaje) →
#      "Tus apps" → selecciona tu app Android.
#   3. En "Configuración del SDK" → "Configuración" (no "google-services.json")
#      verás los valores de firebaseConfig. Cópialos aquí.
#
# IMPORTANTE:
# - Las claves con prefijo EXPO_PUBLIC_ se incluyen en el bundle final del
#   cliente. Son identificadores públicos, no secretos del servidor.
# - No subas el archivo .env al repo. Está ignorado por .gitignore.
# - Solo se commitea este .env.example como plantilla.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Emulador (solo si trabajas sin tocar producción) ---
# Cuando EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true, la app se conecta a los
# emuladores locales en lugar de a Firebase real. Ejecuta antes
# `npm run emulator` (necesita firebase-tools instalado globalmente).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080