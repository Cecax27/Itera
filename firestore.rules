rules_version = '2';

// Reglas de seguridad de Firestore para Itera (MVP).
//
// Filosofía: cada usuario solo accede a sus propios datos. Los documentos
// viven bajo `users/{userId}/...` para que esta regla sea una sola.
//
// El MVP es de un solo usuario (el desarrollador). Cuando se abra a más
// personas, esta regla no necesita cambiar: sigue aplicando la misma
// propiedad (solo el dueño accede a su subárbol).

service cloud.firestore {
  match /databases/{database}/documents {

    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Las propuestas y sus decisiones solo las escribe Cloud Functions
    // (Admin SDK); el cliente autenticado puede consultarlas.
    match /users/{userId}/planChanges/{changeId} {
      allow read: if ownsUserData(userId);
      allow write: if false;
    }

    // Cualquier usuario autenticado solo accede a su propio subárbol, salvo
    // las escrituras de planChanges, reservadas a Cloud Functions.
    match /users/{userId}/{document=**} {
      allow read: if ownsUserData(userId);
      // Evita que la regla amplia reabra escrituras en planChanges.
      allow write: if ownsUserData(userId) && !document.matches('^planChanges(/.*)?$');
    }

    // Bloqueo por defecto: cualquier otra ruta está denegada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
